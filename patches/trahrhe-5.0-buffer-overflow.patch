+// Proper print to display every isl_pw_qpolynomial case, polynomial_type = 1
+// for ranking and 2 for Ehrhart
+void print_pw_qpolynomial(isl_pw_qpolynomial *input_pw_qpolynomial,
+						  int polynomial_type) {
+	int nb_poly = isl_pw_qpolynomial_n_piece(input_pw_qpolynomial);
+
+	const char *str_polynomial_type;
+
+	if (polynomial_type == 1) {
+		str_polynomial_type = "Ehrhart";
+	} else {
+		str_polynomial_type = "Ranking";
+	}
+
+	// Copy the input string to a modifiable buffer
+	char *str_input_pw_qpolynomial =
+		isl_pw_qpolynomial_to_str(input_pw_qpolynomial);
+	char *start_expr;
+	char *start_cond;
+	char *context = NULL; // For strtok_r
+	char *token;
+
+	// Remove the enclosing brackets and split by semicolon first
+	str_input_pw_qpolynomial = strchr(str_input_pw_qpolynomial, '{') + 1;
+	char *end_brace = strrchr(str_input_pw_qpolynomial, '}');
+	*end_brace = '\0'; // Terminate string before the last closing brace
+
+	token = strtok_r(str_input_pw_qpolynomial, ";", &context);
+
+	printf("==== %s Polynomials ====\n"
+		   "-----------------------------\n",
+		   str_polynomial_type);
+
+	if (!strchr(token, ':')) {
+		printf("Case no. 1\n"
+			   "----------\n"
+			   "Validity domain :\n"
+			   "    Whole domain\n"
+			   "%s Expression :\n"
+			   "    %s\n\n",
+			   str_polynomial_type, token);
+	} else {
+		// Loop through the Ehrhart polynomials
+		for (int i = 0; i < nb_poly; i++) {
+
+			// Split the token into expression and condition based on ':'
+			start_expr = strtok_r(token, ":", &token);
+			start_cond = strtok_r(NULL, ":", &token);
+
+			// Trim spaces
+			while (*start_expr == ' ')
+				start_expr++;
+			while (*start_cond == ' ')
+				start_cond++;
+
+			printf("Case no. %d\n"
+				   "----------\n"
+				   "Validity domain :\n"
+				   "    %s\n"
+				   "%s Expression :\n"
+				   "    %s\n\n",
+				   i, start_cond, str_polynomial_type, start_expr);
+
+			// Get the next token for the loop
+			token = strtok_r(NULL, ";", &context);
+		}
+	}
 }
 
