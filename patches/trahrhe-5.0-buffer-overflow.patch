+// Convert an isl_pw_qpolynomial into a string C function, function_type is 1
+// when Ehrhart and 2 when ranking
+int isl_pw_qpolynomial_to_c_function_str(
+	isl_pw_qpolynomial *input_pw_qpolynomial, isl_set *input_set,
+	int function_type, FILE *input_header_file) {
+	struct isl_ctx *printer_ctx = isl_ctx_alloc();
+
+	struct isl_printer *p = isl_printer_to_str(printer_ctx);
+
+	p = isl_printer_set_output_format(p, ISL_FORMAT_C);
+
+	char *function_name = (char *)malloc(STR_VAR_SIZE * sizeof(char));
+
+	if (function_type == 0) {
+		sprintf(function_name, "Ehrhart");
+	}
+	if (function_type == 1) {
+		sprintf(function_name, "Ranking");
+	}
+	if (function_type == 2) {
+		sprintf(function_name, "%s_Ehrhart",
+				isl_set_get_dim_name(input_set, isl_dim_out, 0));
+	}
+	if (function_type == 3) {
+		sprintf(function_name, "%s_Ranking",
+				isl_set_get_dim_name(input_set, isl_dim_out, 0));
+	}
+
+	int nb_case = isl_pw_qpolynomial_n_piece(input_pw_qpolynomial);
+
+	fprintf(input_header_file,
+			"/******************************** %s Polynomials "
+			"********************************/\n"
+			"static inline long int %s(",
+			function_name, function_name);
+
+	int nb_var = isl_set_dim(input_set, isl_dim_out);
+	int nb_param = isl_set_dim(input_set, isl_dim_param);
+
+	if (function_type == 1 || function_type == 3) {
+		if (nb_var > 0) {
+			for (int i = 0; i < nb_var - 1; i++) {
+				fprintf(input_header_file, "long int %s,",
+						isl_set_get_dim_name(input_set, isl_dim_out, i));
+			}
+			fprintf(input_header_file, "long int %s",
+					isl_set_get_dim_name(input_set, isl_dim_out, nb_var - 1));
+		}
+	}
+
+	if (function_type == 0 || function_type == 2) {
+		if (nb_param > 0) {
+			for (int i = 0; i < nb_param - 1; i++) {
+				fprintf(input_header_file, "long int %s,",
+						isl_set_get_dim_name(input_set, isl_dim_param, i));
+			}
+			fprintf(
+				input_header_file, "long int %s",
+				isl_set_get_dim_name(input_set, isl_dim_param, nb_param - 1));
+		}
+	} else {
+		if (nb_param > 0) {
+			for (int i = 0; i < nb_param; i++) {
+				fprintf(input_header_file, ",long int %s",
+						isl_set_get_dim_name(input_set, isl_dim_param, i));
+			}
+		}
+	}
+	fprintf(input_header_file, ")\n{\n");
+
+	p = isl_printer_print_pw_qpolynomial(p, input_pw_qpolynomial);
+
+	// Copy the input string to a modifiable buffer
+	char *str_pw_qpolynomial_input = isl_printer_get_str(p);
+
+	p = isl_printer_flush(p);
+
+	char *start_expr;
+	char *start_cond;
+	char *context = NULL; // For strtok_r
+	char *token;
+
+	token = strtok_r(str_pw_qpolynomial_input, ":", &context);
+
+	if (!strchr(token, '?')) {
+		fprintf(input_header_file,
+				"    return %s;\n"
+				"}\n",
+				token);
+		return 0;
+	} else {
+		// Loop through the polynomials
+		for (int i = 0; i < nb_case; i++) {
+			// Split the token into expression and condition based on '?'
+			start_cond = strtok_r(token, "?", &token);
+			start_expr = strtok_r(NULL, "?", &token);
+
+			// Trim spaces
+			while (*start_expr == ' ')
+				start_expr++;
+			while (*start_cond == ' ')
+				start_cond++;
+
+			fprintf(input_header_file,
+					"    if(%s)\n"
+					"    {\n"
+					"        return %s;\n"
+					"    }\n",
+					start_cond, start_expr);
+
+			// Get the next token for the loop
+			token = strtok_r(NULL, ":", &context);
+		}
+	}
+
+	fprintf(input_header_file,
+			"    fprintf(stderr,\"Error %s: no corresponding domain: (",
+			function_name);
+
+	if (function_type == 1 || function_type == 3) {
+		if (nb_var > 0) {
+			for (int i = 0; i < nb_var - 1; i++) {
+				fprintf(input_header_file, "%s,",
+						isl_set_get_dim_name(input_set, isl_dim_out, i));
+			}
+			fprintf(input_header_file, "%s",
+					isl_set_get_dim_name(input_set, isl_dim_out, nb_var - 1));
+		}
+	}
+	if (nb_param > 0) {
+		for (int i = 0; i < nb_param; i++) {
+			fprintf(input_header_file, ",%s",
+					isl_set_get_dim_name(input_set, isl_dim_param, i));
+		}
+	}
+
+	fprintf(input_header_file, ") = (");
+
