 source/pprint.c             |  30 ++++-
 test/openscop/loops2.c      |  57 ++++++++
 test/openscop/loops2.good.c |  60 +++++++++
 test/openscop/loops2.scop   | 262 ++++++++++++++++++++++++++++++++++++
 5 files changed, 409 insertions(+), 1 deletion(-)
 create mode 100644 test/openscop/loops2.c
 create mode 100644 test/openscop/loops2.good.c
 create mode 100644 test/openscop/loops2.scop

