#!/usr/env/bin bash

PESTO=@PESTO_CLI_BIN@
CC=@CMAKE_C_COMPILER@
MAKE="make"
DATASET_SIZE=@PESTO_TEST_POLYBENCH_DATASET@
MIN_TILE_SIZE=@PESTO_TEST_POLYBENCH_TILE_DIVIDER_MIN@
MAX_TILE_SIZE=@PESTO_TEST_POLYBENCH_TILE_DIVIDER_MAX@
RUN_NB=5

# for cleanup only
ALL_BENCHMARKS=(
    "datamining/correlation"
    "datamining/covariance"
    "linear-algebra/blas/gemm"
    "linear-algebra/blas/gemver"
    "linear-algebra/blas/gesummv"
    # "linear-algebra/blas/symm"
    "linear-algebra/blas/syr2k"
    "linear-algebra/blas/syrk"
    "linear-algebra/blas/trmm"
    "linear-algebra/kernels/2mm"
    "linear-algebra/kernels/3mm"
    "linear-algebra/kernels/atax"
    "linear-algebra/kernels/bicg"
    "linear-algebra/kernels/doitgen"
    "linear-algebra/kernels/mvt"
    "linear-algebra/solvers/cholesky"
    "linear-algebra/solvers/gramschmidt"
    "linear-algebra/solvers/lu"
    # "stencils/adi"
    "stencils/fdtd-2d"
    "stencils/jacobi-1d"
    "stencils/jacobi-2d"
    "stencils/seidel-2d"
)

BENCHMARKS=(
    "datamining/correlation"
    "datamining/covariance"
    "linear-algebra/blas/gemm"
    "linear-algebra/blas/gemver"
    "linear-algebra/blas/gesummv"
    # "linear-algebra/blas/symm"
    "linear-algebra/blas/syr2k"
    "linear-algebra/blas/syrk"
    "linear-algebra/blas/trmm"
    "linear-algebra/kernels/2mm"
    "linear-algebra/kernels/3mm"
    "linear-algebra/kernels/atax"
    "linear-algebra/kernels/bicg"
    "linear-algebra/kernels/doitgen"
    "linear-algebra/kernels/mvt"
)

DYNSCHEDULE_BENCHMARKS=(
    # "stencils/adi"
    # "stencils/fdtd-2d" # fdtd-2d is not supported yet
    "stencils/jacobi-1d"
    "stencils/jacobi-2d"
    "stencils/seidel-2d"
)

TPZ_BENCHMARKS=(
    # "stencils/adi"
    "stencils/fdtd-2d"
    "stencils/heat-3d"
    "stencils/jacobi-1d"
    "stencils/jacobi-2d"
    "stencils/seidel-2d"
)

CONFIGS=(
    "config/ptile.json"
    "config/hybrid.json"
)

CFLAGS="-march=native -O3 -fopenmp"
EXTRA_FLAGS="-lm -DPOLYBENCH_TIME -DPOLYBENCH_DUMP_ARRAYS -D$DATASET_SIZE $EXTRA_FLAGS"

# Define colors
GREEN="\e[32m"
RED="\e[31m"
BLUE="\e[34m"
WHITE="\e[97m"
BOLD="\e[1m"
RESET="\e[0m"

INFO="[   ${WHITE}INFO${RESET}   ]"

cleanup_test() {
    local benchmark="$1"
    local benchmark_name
    benchmark_name=$(basename "$benchmark")

    rm -f "$benchmark/$benchmark_name"
    rm -f "$benchmark"/*.pesto.c
    rm -f "$benchmark"/*.pesto
    rm -f "$benchmark"/*.dump
    rm -f "$benchmark/$benchmark.trahrhe."*
    rm -f "./.pesto*"
}
cleanup_all() {
    echo ""
    echo -e "${BOLD}===========================================${RESET}"
    echo -e "${BOLD}              Cleaning up                  ${RESET}"
    echo -e "${BOLD}===========================================${RESET}"
    for benchmark in "${ALL_BENCHMARKS[@]}"; do
        cleanup_test "$benchmark"
    done
}

trap cleanup_all EXIT

# Print header
echo -e "${BOLD}==========================================${RESET}"
echo -e "${BOLD}     Pesto CLI Test Suite - Polybench     ${RESET}"
echo -e "${BOLD}==========================================${RESET}\n"

# Test function
run_test() {
    # args
    local benchmark="$1"
    local make_target="$2"
    local pesto_config="$3"

    # local variables
    local benchmark_name
    local command

    # extract test name
    benchmark_name=$(basename "$benchmark")

    echo ""
    echo -e "[   ${BLUE}TEST${RESET}   ] $benchmark"

    # compile vanilla program
    command=("${MAKE}" -C "$benchmark" "${benchmark_name}" -B EXTRA_FLAGS="$EXTRA_FLAGS")
    echo -e "${INFO} Compiling baseline"
    if ! "${command[@]}"; then
        echo -e "[ ${RED}  FAIL  ${RESET} ] Compilation failed: ${command[*]}"
        return 1
    fi

    # run the program
    command=("./$benchmark/${benchmark_name}")
    output_dump="$benchmark/${benchmark_name}.dump"
    echo -e "${INFO} Run command: ${command[*]}"
    if ! "${command[@]}" 2>"$output_dump" >/dev/null; then
        echo -e "[ ${RED}  FAIL  ${RESET} ] Execution failed: ${command[*]}"
        return 1
    fi
    expected_output=$(sha256sum "$benchmark/${benchmark_name}.dump" | cut -d' ' -f1)
    echo -e "${INFO} Expected output hash: $expected_output"

    command=("${MAKE}" -C "$benchmark" "${benchmark_name}" -B CC="$CC" PESTO="$PESTO" PESTO_CONFIG="$pesto_config" EXTRA_FLAGS="$EXTRA_FLAGS")
    echo -e "${INFO} Generate pesto program"
    if ! "${command[@]}" >/dev/null 2>&1; then
        echo -e "[ ${RED}  FAIL  ${RESET} ] Pesto failed: ${command[*]}"
        return 1
    fi

    # compile and run pesto program $RUN_NB times with random divider sizes
    if [ "$MIN_TILE_SIZE" -eq "$MAX_TILE_SIZE" ]; then
        div_list=$(yes "$MIN_TILE_SIZE" | head -n $((RUN_NB * 3)))
    else
        div_list=$(shuf -i "$MIN_TILE_SIZE-$MAX_TILE_SIZE" -n $((RUN_NB * 3)))
    fi
    for ((i = 0; i < RUN_NB; i++)); do
        D1=$(sed "$((i * 3 + 1))q;d" <<<"$div_list")
        D2=$(sed "$((i * 3 + 1))q;d" <<<"$div_list")
        D3=$(sed "$((i * 3 + 2))q;d" <<<"$div_list")

        rm -f "$benchmark/$make_target"
        command=("${MAKE}" -C "$benchmark" "${make_target}" CC="$CC" PESTO="$PESTO" PESTO_CONFIG="$pesto_config" EXTRA_FLAGS="$EXTRA_FLAGS -DDIV0=$D1 -DDIV1=$D2 -DDIV2=$D3")
        echo -e "${INFO} Compile pesto program ${D1}x${D2}x${D3}"
        if ! "${command[@]}" >/dev/null 2>&1; then
            echo -e "[ ${RED}  FAIL  ${RESET} ] Compilation failed: ${command[*]}"
            return 1
        fi
        command=("./$benchmark/$make_target")
        output_dump="$benchmark/${make_target}.dump"
        echo -e "${INFO} Run command: ${command[*]}"
        if ! "${command[@]}" 2>"$output_dump" >/dev/null; then
            echo -e "[ ${RED}  FAIL  ${RESET} ] Execution failed"
            return 1
        fi
        output=$(sha256sum "$benchmark/${make_target}.dump" | cut -d' ' -f1)
        if [[ "$output" != "$expected_output" ]]; then
            echo -e "[ ${RED}  FAIL  ${RESET} ] Output differs from expected result"
            echo -e "[ ${RED}  DIFF  ${RESET} ] Expected: \"$expected_output\""
            echo -e "[ ${RED}  DIFF  ${RESET} ] Got: \"$output\""
            return 1
        else
            echo -e "[ ${GREEN}  PASS  ${RESET} ] Output matches expected: \"$expected_output\""
        fi
    done

    echo -e "${INFO} Cleaning "
    command=("${MAKE}" -C "$benchmark" "clean")
    "${command[@]}" >/dev/null 2>&1
    return 0
}

# Run tests
pass_count=0
fail_count=0

for config in "${CONFIGS[@]}"; do
    config_path=$(realpath "$config")
    echo ""
    echo -e "${BOLD}==========================================================${RESET}"
    echo -e "${BOLD}  Running tests with configuration: $config${RESET}"
    echo -e "${BOLD}==========================================================${RESET}"
    for benchmark in "${BENCHMARKS[@]}"; do
        benchmark_name=$(basename "$benchmark")
        if run_test "$benchmark" "${benchmark_name}_pesto" "$config_path"; then
            pass_count=$((pass_count + 1))
        else
            fail_count=$((fail_count + 1))
        fi
        cleanup_test "$benchmark"
    done
done

# Dynamic scheduling tests
echo ""
echo -e "${BOLD}==========================================================${RESET}"
echo -e "${BOLD}         Running tests with dynamic scheduling            ${RESET}"
echo -e "${BOLD}==========================================================${RESET}"
config=$(realpath "config/ptile.json")
for benchmark in "${DYNSCHEDULE_BENCHMARKS[@]}"; do
    benchmark_name=$(basename "$benchmark")
    if run_test "$benchmark" "${benchmark_name}_pesto" "$config"; then
        pass_count=$((pass_count + 1))
    else
        fail_count=$((fail_count + 1))
    fi
    cleanup_test "$benchmark"
done

# Trapezoidal tiling tests
echo ""
echo -e "${BOLD}==========================================================${RESET}"
echo -e "${BOLD}          Running tests with trapezoidal tiling           ${RESET}"
echo -e "${BOLD}==========================================================${RESET}"
EXTRA_FLAGS_OLD="$EXTRA_FLAGS"
EXTRA_FLAGS="$EXTRA_FLAGS -DD1_MIN_VOL=200000"
BK_RUN_NB=$RUN_NB
# Some magic here those values work well for trapezoidal tiling
# on the tested benchmarks
MIN_TILE_SIZE=10
MAX_TILE_SIZE=10

RUN_NB=1

for benchmark in "${TPZ_BENCHMARKS[@]}"; do
    benchmark_name=$(basename "$benchmark")
    if run_test "$benchmark" "${benchmark_name}_tpz" "$config"; then
        pass_count=$((pass_count + 1))
    else
        fail_count=$((fail_count + 1))
    fi
    cleanup_test "$benchmark"
done
# Restore original EXTRA_FLAGS
EXTRA_FLAGS="$EXTRA_FLAGS_OLD"
MIN_TILE_SIZE=@PESTO_TEST_POLYBENCH_TILE_DIVIDER_MIN@
MAX_TILE_SIZE=@PESTO_TEST_POLYBENCH_TILE_DIVIDER_MAX@
RUN_NB=$BK_RUN_NB

#########################################################################################
# End tests
#########################################################################################

# Print summary
echo ""
echo -e "${BOLD}============================================${RESET}"
echo -e "${BOLD}              TEST SUMMARY${RESET}"
echo -e "${BOLD}============================================${RESET}"
echo -e "✔ ${GREEN}PASSED${RESET}: $pass_count"
echo -e "✘ ${RED}FAILED${RESET}: $fail_count"
echo -e "${BOLD}============================================${RESET}"

# Exit with appropriate status
[[ $fail_count -eq 0 ]] && exit 0 || exit 1
