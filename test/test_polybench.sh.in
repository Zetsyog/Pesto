#!/usr/env/bin bash

PESTO=@PESTO_CLI_BIN@
CC=@CMAKE_C_COMPILER@
MAKE="make"
DATASET_SIZE=@PESTO_TEST_POLYBENCH_DATASET@
MIN_TILE_SIZE=@PESTO_TEST_POLYBENCH_TILE_DIVIDER_MIN@
MAX_TILE_SIZE=@PESTO_TEST_POLYBENCH_TILE_DIVIDER_MAX@
RUN_NB=5

# for cleanup only
ALL_BENCHMARKS=(
    "datamining/correlation"
    "datamining/covariance"
    "linear-algebra/blas/gemm"
    "linear-algebra/blas/gemver"
    "linear-algebra/blas/gesummv"
    "linear-algebra/blas/symm"
    "linear-algebra/blas/syr2k"
    "linear-algebra/blas/syrk"
    "linear-algebra/blas/trmm"
    "linear-algebra/kernels/2mm"
    "linear-algebra/kernels/3mm"
    "linear-algebra/kernels/atax"
    "linear-algebra/kernels/bicg"
    "linear-algebra/kernels/doitgen"
    "linear-algebra/kernels/mvt"
    "linear-algebra/solvers/cholesky"
    "linear-algebra/solvers/durbin"
    "linear-algebra/solvers/gramschmidt"
    "linear-algebra/solvers/lu"
    "linear-algebra/solvers/ludcmp"
    "linear-algebra/solvers/trisolv"
    "medley/deriche"
    "medley/floyd-warshall"
    "medley/nussinov"
    "stencils/adi"
    "stencils/fdtd-2d"
    "stencils/jacobi-1d"
    "stencils/jacobi-2d"
    "stencils/seidel-2d"
)

CFLAGS="-march=native -O3 -fopenmp"
EXTRA_FLAGS="-lm -DPOLYBENCH_TIME -DPOLYBENCH_DUMP_ARRAYS -D$DATASET_SIZE"

# Define colors
GREEN="\e[32m"
RED="\e[31m"
BLUE="\e[34m"
WHITE="\e[97m"
BOLD="\e[1m"
RESET="\e[0m"

INFO="[   ${WHITE}INFO${RESET}   ]"

cleanup_test() {
    local benchmark="$1"
    local benchmark_name
    benchmark_name=$(basename "$benchmark")

    rm -f "$benchmark/$benchmark_name"
    rm -f "$benchmark"/*.pesto.c
    rm -f "$benchmark"/*.pesto
    rm -f "$benchmark"/*.dump
    rm -f "$benchmark/$benchmark.trahrhe."*
    rm -f "./.pesto*"
}
cleanup_all() {
    echo ""
    echo -e "${BOLD}===========================================${RESET}"
    echo -e "${BOLD}              Cleaning up                  ${RESET}"
    echo -e "${BOLD}===========================================${RESET}"
    for benchmark in "${ALL_BENCHMARKS[@]}"; do
        echo -e "${INFO} Cleaning $benchmark"
        cleanup_test "$benchmark"
    done
}

center64() {
    local txt="${1:-}"                     # the text to centre
    local width=64                         # fixed field width
    local fill="${2:- }"                   # padding character (space by default)
    local truncate="${CENTER_TRUNCATE:-0}" # 1 → truncate, 0 → leave as‑is

    local txt_len
    txt_len=$(printf '%s' "$txt" | wc -m)
    # wc prints leading spaces, strip them:
    txt_len=${txt_len##* }

    if ((txt_len > width)); then
        if ((truncate)); then
            # Cut the string to the first $width characters.
            # `cut -c` works on *characters*, not bytes.
            txt=$(printf '%s' "$txt" | cut -c1-"$width")
            txt_len=$width
        else
            printf '%s\n' "$txt"
            return
        fi
    fi

    local pad=$((width - txt_len))
    local pad_left=$((pad / 2))
    local pad_right=$((pad - pad_left))

    local left_pad right_pad
    left_pad=$(printf '%*s' "$pad_left" '' | tr ' ' "$fill")
    right_pad=$(printf '%*s' "$pad_right" '' | tr ' ' "$fill")

    printf '%s%s%s\n' "$left_pad" "$txt" "$right_pad"
}

print_header() {
    local title="${1:-}"
    local subtitle="${2:-}"

    echo ""
    center64 "" "="
    center64 "$title"
    center64 "" "-"
    center64 "$subtitle"
    center64 "" "="
    echo "CFLAGS=$CFLAGS"
    echo "EXTRA_FLAGS=$EXTRA_FLAGS"
    echo "C Compiler=$CC"
    echo "Pesto CLI=$PESTO"
    echo "Dataset size=$DATASET_SIZE"
    echo "Tile size range=$MIN_TILE_SIZE - $MAX_TILE_SIZE"
    echo "Runs per test=$RUN_NB"
}

print_results() {
    center64 "" "="
    center64 "TEST SUMMARY"
    center64 "" "="
    echo -e "✔ ${GREEN}PASSED${RESET}: $pass_count"
    echo -e "✘ ${RED}FAILED${RESET}: $fail_count"
    echo -e " "
    center64 "" "="

}

trap cleanup_all EXIT

# Run tests
pass_count=0
fail_count=0

# Test function
function run_test() {
    # args
    local benchmark="$1"
    local baseline_target="$2"
    local compared_target="$3"

    # local variables
    local benchmark_name
    local command

    # extract test name
    benchmark_name=$(basename "$benchmark")

    echo ""
    echo -e "[   ${BLUE}TEST${RESET}   ] $benchmark"

    # compile vanilla program
    command=("${MAKE}" -C "$benchmark" "$baseline_target" -B EXTRA_FLAGS="$EXTRA_FLAGS")
    echo -e "${INFO} Compiling baseline"
    if ! "${command[@]}"; then
        echo -e "[ ${RED}  FAIL  ${RESET} ] Compilation failed: ${command[*]}"
        fail_count=$((fail_count + 1))
        return 1
    fi

    # run the program
    command=("./$benchmark/$baseline_target")
    output_dump="$benchmark/$baseline_target.dump"
    echo -e "${INFO} Run command: ${command[*]}"
    if ! "${command[@]}" 2>"$output_dump" >/dev/null; then
        echo -e "[ ${RED}  FAIL  ${RESET} ] Execution failed: ${command[*]}"
        fail_count=$((fail_count + 1))
        return 1
    fi
    expected_output=$(sha256sum "$benchmark/$baseline_target.dump" | cut -d' ' -f1)
    echo -e "${INFO} Expected output hash: $expected_output"

    # compile and run pesto program $RUN_NB times with random divider sizes
    if [ "$MIN_TILE_SIZE" -eq "$MAX_TILE_SIZE" ]; then
        div_list=$(printf '%s\n' "$(seq 1 $((RUN_NB * 3)))" | xargs -I{} echo "$MIN_TILE_SIZE")
    else
        div_list=$(shuf -i "$MIN_TILE_SIZE-$MAX_TILE_SIZE" -n $((RUN_NB * 3)))
    fi
    for ((i = 0; i < RUN_NB; i++)); do
        D1=$(sed "$((i * 3 + 1))q;d" <<<"$div_list")
        D2=$(sed "$((i * 3 + 1))q;d" <<<"$div_list")
        D3=$(sed "$((i * 3 + 2))q;d" <<<"$div_list")

        rm -f "$benchmark/$compared_target"
        command=("${MAKE}" -C "$benchmark" "${compared_target}" CC="$CC" PESTO="$PESTO" EXTRA_FLAGS="$EXTRA_FLAGS -DDIV0=$D1 -DDIV1=$D2 -DDIV2=$D3")
        echo -e "${INFO} Compile pesto program ${D1}x${D2}x${D3}"
        if ! "${command[@]}" >/dev/null 2>&1; then
            echo -e "[ ${RED}  FAIL  ${RESET} ] Compilation failed: ${command[*]}"
            fail_count=$((fail_count + 1))
            return 1
        fi
        command=("./$benchmark/$compared_target")
        output_dump="$benchmark/${compared_target}.dump"
        echo -e "${INFO} Run command: ${command[*]}"
        if ! "${command[@]}" 2>"$output_dump" >/dev/null; then
            echo -e "[ ${RED}  FAIL  ${RESET} ] Execution failed"
            fail_count=$((fail_count + 1))
            return 1
        fi
        output=$(sha256sum "$benchmark/${compared_target}.dump" | cut -d' ' -f1)
        if [[ "$output" != "$expected_output" ]]; then
            echo -e "[ ${RED}  FAIL  ${RESET} ] Output differs from expected result"
            echo -e "[ ${RED}  DIFF  ${RESET} ] Expected: \"$expected_output\""
            echo -e "[ ${RED}  DIFF  ${RESET} ] Got: \"$output\""
            fail_count=$((fail_count + 1))
            return 1
        else
            echo -e "[ ${GREEN}  PASS  ${RESET} ] Output matches expected: \"$expected_output\""
        fi
    done
    pass_count=$((pass_count + 1))

    echo -e "${INFO} Cleaning "
    command=("${MAKE}" -C "$benchmark" "clean")
    "${command[@]}" >/dev/null 2>&1
    return 0
}
