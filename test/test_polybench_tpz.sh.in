#!/usr/env/bin bash

source "@PESTO_TEST_POLYBENCH_SCRIPT@"

BENCHMARKS=(
    "stencils/fdtd-2d"
    "stencils/heat-3d"
    "stencils/jacobi-1d"
    "stencils/jacobi-2d"
    "stencils/seidel-2d"
)
MIN_TILE_SIZE=10
MAX_TILE_SIZE=10
RUN_NB=1
EXTRA_FLAGS="$EXTRA_FLAGS -DD1_MIN_VOL=200000"

config_path=$(realpath "config/tpz.json")

print_header "Pesto CLI Test Suite - Polybench" "Hybrid algebraic tiling tests"

for benchmark in "${BENCHMARKS[@]}"; do
    benchmark_name=$(basename "$benchmark")
    run_test "$benchmark" "${benchmark_name}_pesto" "$config_path"
    cleanup_test "$benchmark"
done

print_results
