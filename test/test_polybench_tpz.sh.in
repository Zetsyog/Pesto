#!/usr/env/bin bash

source "@PESTO_TEST_POLYBENCH_SCRIPT@"

BENCHMARKS=(
    "stencils/fdtd-2d"
    "stencils/heat-3d"
    "stencils/jacobi-1d"
    "stencils/jacobi-2d"
    "stencils/seidel-2d"
)
MIN_TILE_SIZE=10
MAX_TILE_SIZE=10
RUN_NB=1
EXTRA_FLAGS="$EXTRA_FLAGS -DD1_MIN_VOL=200000"

print_header "Pesto CLI Test Suite - Polybench" "Trapezoidal algebraic tiling tests"

for benchmark in "${BENCHMARKS[@]}"; do
    run_test "$benchmark" "baseline" "trapez"
    cleanup_test "$benchmark"
done

print_results

# Exit with appropriate status
[[ $fail_count -eq 0 ]] && exit 0 || exit 1
