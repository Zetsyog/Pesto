#!/usr/bin/env bash

# This script is used to retrieve the chksum of a polybench program
# usage: pb_chksum [source_file] [EXTRA_FLAGS]

CFLAGS="-march=native -fopenmp -O3 -DPOLYBENCH_TIME -DPOLYBENCH_DUMP_ARRAYS"
LD_FLAGS="-lm"
EXTRAFLAGS=""

ROOT_DIR=$(realpath "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)/../")
POLYBENCH_DIR="$ROOT_DIR/"

if [ $# -lt 1 ]; then
    echo "Usage: ./pb_chksum <source_file> [EXTRA_FLAGS]"
    exit 1
fi

if [ $# -eq 2 ]; then
    EXTRAFLAGS=$2
fi

cleanup() {
    rm -f __tmp __tmp.dump
}

source_file=$1
source_dir=$(dirname $source_file)

gcc -o __tmp $CFLAGS "$POLYBENCH_DIR/polybench.c" -I "$ROOT_DIR/include/" -I "$source_dir" "$source_file" $LD_FLAGS $EXTRAFLAGS
if [ $? -ne 0 ]; then
    echo "Compilation failed"
    echo "command :"
    echo gcc -o __tmp $CFLAGS "$POLYBENCH_DIR/polybench.c" -I "$ROOT_DIR/include/" -I "$source_dir" "$source_file" $LD_FLAGS $EXTRAFLAGS
    exit 1
fi

echo "$source_file" >&2

if ! ./__tmp 2>"__tmp.dump" >"__out"; then
    echo "Program execution failed"
    cleanup
    exit 1
fi
sha256sum "__tmp.dump" | cut -d' ' -f1 >>"__out"
head -n 2 "__out" | paste -sd ' '

# cleaning up
cleanup
