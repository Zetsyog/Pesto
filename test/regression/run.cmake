# Each test owns its directory. A failure retains sources, commands, diagnostics,
# and complete dumps; rerun exactly one case with ctest -R '^regression-...$'.
file(MAKE_DIRECTORY "${WORK_DIR}")
set(ENV{TMPDIR} "${WORK_DIR}")
set(ENV{OMP_DYNAMIC} FALSE)
set(ENV{OMP_THREAD_LIMIT} 4)
set(ENV{OMP_PROC_BIND} FALSE)
set(ENV{ASAN_OPTIONS} "detect_leaks=0:halt_on_error=1")
set(ENV{UBSAN_OPTIONS} "halt_on_error=1:print_stacktrace=1")
file(WRITE "${WORK_DIR}/commands.log" "")
configure_file("${SOURCE_DIR}/fixtures/${FIXTURE}.c" "${WORK_DIR}/input.c" COPYONLY)
configure_file("${SOURCE_DIR}/fixtures/fixture.h" "${WORK_DIR}/fixture.h" COPYONLY)

function(run phase)
    string(JOIN " " display ${ARGN})
    file(APPEND "${WORK_DIR}/commands.log" "${phase}: ${display}\n")
    execute_process(
        COMMAND ${ARGN} WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE status OUTPUT_FILE "${WORK_DIR}/${phase}.out"
        ERROR_FILE "${WORK_DIR}/${phase}.err" TIMEOUT 30
    )
    if(NOT "${status}" STREQUAL "0")
        file(READ "${WORK_DIR}/${phase}.err" errors)
        message(FATAL_ERROR "${FIXTURE}/${PIPELINE}: ${phase} failed (${status})\n${errors}\nArtifacts: ${WORK_DIR}")
    endif()
endfunction()

set(passes "{\"uuid\":\"pluto\",\"options\":{\"tile\":true,\"parallel\":true,\"prevector\":false,\"unrolljam\":false,\"tile-sizes\":[${TILE},${TILE},${TILE}]}}")
if(PIPELINE MATCHES "^(param-rect|hybrid|algebraic)$")
    set(types "\"rectangular\",\"rectangular\",\"rectangular\"")
    set(headers false)
    if(PIPELINE STREQUAL "hybrid")
        set(types "\"algebraic\",\"rectangular\",\"rectangular\"")
        set(headers true)
    elseif(PIPELINE STREQUAL "algebraic")
        set(types "\"algebraic\",\"algebraic\",\"algebraic\"")
        set(headers true)
    endif()
    string(APPEND passes ",{\"uuid\":\"param-tiling\",\"types\":[${types}],\"gen-trahrhe\":${headers},\"volumeCheck\":{\"strategy\":\"no-check\"}}")
endif()
file(WRITE "${WORK_DIR}/pipeline.json" "{\"passes\":[${passes},{\"uuid\":\"codegen-cloog\"}]}\n")
if(PIPELINE STREQUAL "codegen")
    file(WRITE "${WORK_DIR}/pipeline.json" "{\"passes\":[{\"uuid\":\"codegen-cloog\"}]}\n")
endif()
set(config_args --config "${WORK_DIR}/pipeline.json")
if(PIPELINE STREQUAL "default")
    file(WRITE "${WORK_DIR}/pipeline.json" "{\"passes\":[{\"uuid\":\"pluto\"},{\"uuid\":\"codegen-cloog\"}]}\n")
    set(config_args)
endif()
file(REMOVE "${WORK_DIR}/generated.c")
# A previous successful run must not supply a header that this run forgot to emit.
file(GLOB previous_headers "${WORK_DIR}/generated.trahrhe.*.h")
if(previous_headers)
    file(REMOVE ${previous_headers})
endif()
run(transform "${PESTO}" ${config_args} input.c -o generated.c)
if(NOT EXISTS "${WORK_DIR}/generated.c")
    message(FATAL_ERROR "No generated source: ${WORK_DIR}")
endif()
if(PIPELINE MATCHES "^(param-rect|hybrid|algebraic)$")
    file(READ "${WORK_DIR}/generated.c" generated)
    if(NOT generated MATCHES "DIV0")
        message(FATAL_ERROR "Parameter tiling was not exercised: ${WORK_DIR}")
    endif()
endif()

set(flags -O2 -g -fopenmp -fno-omit-frame-pointer)
if(SANITIZERS)
    list(APPEND flags -fsanitize=address,undefined -fno-sanitize-recover=all)
endif()
run(compile-baseline "${CC}" ${flags} input.c -o baseline -lm)
foreach(n IN ITEMS 0 1 2 3 4 7 8 9 17)
    foreach(seed IN ITEMS 1 7)
        set(ENV{OMP_NUM_THREADS} 1)
        run(baseline-n${n}-seed${seed} "${WORK_DIR}/baseline" "${n}" "${seed}")
        file(SIZE "${WORK_DIR}/baseline-n${n}-seed${seed}.out" dump_size)
        if(dump_size EQUAL 0)
            message(FATAL_ERROR "Baseline produced no result dump: ${WORK_DIR}")
        endif()
    endforeach()
endforeach()

set(dividers standard)
if(PIPELINE MATCHES "^(param-rect|hybrid|algebraic)$")
    set(dividers unit uneven oversized)
endif()
foreach(divider IN LISTS dividers)
    set(tile_flags)
    if(divider STREQUAL "unit")
        set(tile_flags -DDIV0=1 -DDIV1=1 -DDIV2=1)
    elseif(divider STREQUAL "uneven")
        set(tile_flags -DDIV0=3 -DDIV1=5 -DDIV2=7)
    elseif(divider STREQUAL "oversized")
        set(tile_flags -DDIV0=64 -DDIV1=65 -DDIV2=66)
    endif()
    run(compile-${divider} "${CC}" ${flags} ${tile_flags} generated.c -o transformed -lm)
    foreach(n IN ITEMS 0 1 2 3 4 7 8 9 17)
        # Two fixed data patterns exercise values independently of domain shape.
        foreach(seed IN ITEMS 1 7)
            set(case "n${n}-seed${seed}")
            file(SHA256 "${WORK_DIR}/baseline-${case}.out" expected)
            foreach(threads IN ITEMS 1 2 4)
                set(ENV{OMP_NUM_THREADS} "${threads}")
                run(${divider}-${case}-t${threads} "${WORK_DIR}/transformed" "${n}" "${seed}")
                file(SHA256 "${WORK_DIR}/${divider}-${case}-t${threads}.out" actual)
                if(NOT actual STREQUAL expected)
                    message(FATAL_ERROR "Result mismatch: ${FIXTURE}/${PIPELINE}, ${divider}, ${case}, threads=${threads}\nExpected: ${WORK_DIR}/baseline-${case}.out\nActual: ${WORK_DIR}/${divider}-${case}-t${threads}.out")
                endif()
            endforeach()
        endforeach()
    endforeach()
endforeach()
file(GLOB leftovers "${WORK_DIR}/.pesto-*")
if(leftovers)
    message(FATAL_ERROR "Temporary workspace leak: ${leftovers}")
endif()
