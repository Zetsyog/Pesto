# Run the benchmark probe and summarise it.
#
#   cmake -DCTEST=ctest -DPROBE_DIR=<build>/bench-probe [-DJOBS=n] [-DREPORT_ONLY=ON]
#         -P probe_report.cmake
#
# Without REPORT_ONLY, runs every probe case (failures are expected and do not
# stop the run). A subset can be rerun by hand with
#   ctest --test-dir <build>/bench-probe -R <regex>
# followed by this script with -DREPORT_ONLY=ON.
#
# Writes probe-report.md and probe-report.csv into PROBE_DIR and compares the
# outcome with allowlist.txt (the pairs registered by pesto_bench()).
cmake_policy(VERSION 3.22)

if(NOT REPORT_ONLY)
    if(NOT JOBS)
        set(JOBS 4)
    endif()
    file(REMOVE_RECURSE "${PROBE_DIR}/cases")
    execute_process(COMMAND "${CTEST}" --test-dir "${PROBE_DIR}" --parallel ${JOBS} --progress
        --output-log "${PROBE_DIR}/ctest.log")
endif()

set(allowlist)
if(EXISTS "${PROBE_DIR}/allowlist.txt")
    file(STRINGS "${PROBE_DIR}/allowlist.txt" allowlist)
endif()

file(GLOB_RECURSE results RELATIVE "${PROBE_DIR}/cases" "${PROBE_DIR}/cases/*/result.txt")
list(SORT results)
set(pipelines default tiled atiling hybrid-2d tpz kernel pluto)
set(rows)
set(csv "suite,kernel,pipeline,status,allowlisted\n")
set(candidates)
set(regressions)
set(pass_count 0)
set(total 0)
foreach(result IN LISTS results)
    # <suite>/<kernel>/<pipeline>/result.txt
    string(REPLACE "/" ";" parts "${result}")
    list(GET parts 0 suite)
    list(GET parts 1 kernel)
    list(GET parts 2 pipeline)
    file(STRINGS "${PROBE_DIR}/cases/${result}" first LIMIT_COUNT 1)
    string(REGEX REPLACE " .*" "" status "${first}")
    if(status STREQUAL "")
        set(status unknown)
    endif()
    set(key "${suite}/${kernel}/${pipeline}")
    set(listed no)
    if(key IN_LIST allowlist)
        set(listed yes)
    endif()
    math(EXPR total "${total} + 1")
    if(status STREQUAL "pass")
        math(EXPR pass_count "${pass_count} + 1")
        if(NOT listed AND NOT pipeline STREQUAL "pluto") # reference runs, never allowlisted
            list(APPEND candidates "${key}")
        endif()
    elseif(listed)
        list(APPEND regressions "${key} (${status})")
    endif()
    string(APPEND csv "${suite},${kernel},${pipeline},${status},${listed}\n")
    set(row "${suite}/${kernel}")
    if(NOT row IN_LIST rows)
        list(APPEND rows "${row}")
    endif()
    set(cell "${status}")
    if(listed)
        set(cell "**${status}**")
    endif()
    string(MAKE_C_IDENTIFIER "${row}/${pipeline}" id)
    set(cell_${id} "${cell}")
endforeach()

# Cases that never wrote a result were killed (ctest timeout).
foreach(key IN LISTS allowlist)
    string(MAKE_C_IDENTIFIER "${key}" id)
    if(NOT DEFINED cell_${id} AND NOT key STREQUAL "")
        list(APPEND regressions "${key} (not probed)")
    endif()
endforeach()

set(md "# Benchmark probe\n\n${pass_count}/${total} cases pass. ")
string(APPEND md "Bold cells are allowlisted in test/regression/benchmarks.cmake; ")
string(APPEND md "`-` means the pipeline does not apply. Details: `cases/<suite>/<kernel>/<pipeline>/`.\n\n")
string(APPEND md "| kernel |")
foreach(p IN LISTS pipelines)
    string(APPEND md " ${p} |")
endforeach()
string(APPEND md "\n|---|")
foreach(p IN LISTS pipelines)
    string(APPEND md "---|")
endforeach()
string(APPEND md "\n")
foreach(row IN LISTS rows)
    string(APPEND md "| ${row} |")
    foreach(p IN LISTS pipelines)
        string(MAKE_C_IDENTIFIER "${row}/${p}" id)
        if(DEFINED cell_${id})
            string(APPEND md " ${cell_${id}} |")
        else()
            string(APPEND md " - |")
        endif()
    endforeach()
    string(APPEND md "\n")
endforeach()

string(APPEND md "\n## Passing but not allowlisted\n\n")
if(candidates)
    foreach(c IN LISTS candidates)
        string(APPEND md "- ${c}\n")
    endforeach()
else()
    string(APPEND md "None.\n")
endif()
string(APPEND md "\n## Allowlisted but failing\n\n")
if(regressions)
    foreach(r IN LISTS regressions)
        string(APPEND md "- ${r}\n")
    endforeach()
else()
    string(APPEND md "None.\n")
endif()

file(WRITE "${PROBE_DIR}/probe-report.md" "${md}")
file(WRITE "${PROBE_DIR}/probe-report.csv" "${csv}")
message("${md}")
message("Report: ${PROBE_DIR}/probe-report.md")
list(LENGTH regressions regression_count)
if(regression_count GREATER 0)
    message(FATAL_ERROR "${regression_count} allowlisted case(s) failed in the probe")
endif()
