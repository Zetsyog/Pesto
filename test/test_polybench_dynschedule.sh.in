#!/usr/env/bin bash

source "@PESTO_TEST_POLYBENCH_SCRIPT@"

BENCHMARKS=(
    # linear-algebra/solvers/cholesky # cholesky is not supported yet
    # medley/floyd-warshall
    # "stencils/fdtd-2d" # fdtd-2d is not supported yet
    "stencils/jacobi-1d"
    "stencils/jacobi-2d"
    "stencils/seidel-2d"
)

print_header "Pesto CLI Test Suite - Polybench" "Dynamic scheduling tiling tests"

for benchmark in "${BENCHMARKS[@]}"; do
    run_test "$benchmark" "baseline" "atiled"
    cleanup_test "$benchmark"
done

print_results

# Exit with appropriate status
[[ $fail_count -eq 0 ]] && exit 0 || exit 1
